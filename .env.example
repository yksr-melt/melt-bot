DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
DATABASE_URL="file:./dev.db"

# Lavalink server connection (see lavalink/README や docs参照。npm run lavalink:setup / npm run lavalink でローカル起動)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
# 何もキューに残っていない状態が何msの間続いたらVCから自動切断するか
LAVALINK_IDLE_DISCONNECT_MS=60000

# Spotify (任意, LavaSrcプラグインでSpotifyのURLを直接解決する場合のみ設定する)
# 未設定 (false) の場合、SpotifyのURLはYouTube検索へのフォールバックで再生される
SPOTIFY_SOURCE_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

{
  "name": "melt-bot",
  "version": "0.1.0",
  "private": true,
  "description": "All-in-one Discord management bot for private servers.",
  "main": "src/index.js",
  "scripts": {
    "dev": "concurrently -n lavalink,bot -c yellow,cyan \"npm:lavalink\" \"npm:bot:dev\"",
    "start": "concurrently -n lavalink,bot -c yellow,cyan \"npm:lavalink\" \"npm:bot\"",
    "bot": "node src/index.js",
    "bot:dev": "node --watch src/index.js",
    "register": "node src/register-commands.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lavalink:setup": "bash scripts/setup-lavalink.sh",
    "lavalink": "bash scripts/run-lavalink.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "discord.js": "^14.0.0",
    "dotenv": "^16.4.7",
    "lavalink-client": "^2.11.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prisma": "^6.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
